{
  "manifest_version": 3,
  "name": "SimplyApply — AI Job Autofill",
  "version": "1.4.3",
  "description": "Autofill job applications in one click. Works on Greenhouse, Lever, Ashby, and more. Save your profile once, apply everywhere.",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "cookies", "alarms"],
  "host_permissions": [
    "<all_urls>",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.workday.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.bamboohr.com/*",
    "https://*.jobvite.com/*",
    "https://*.workable.com/*",
    "https://*.recruitee.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://elevate-careers-api.fly.dev/*",
    "https://simplyappl.ai/*",
    "https://owvvrljdfnhntwedepkl.supabase.co/*"
  ],
  "background": { "service_worker": "sw.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Inject Autofill" },
  "content_scripts": [
    {
      "matches": ["https://simplyappl.ai/*", "https://www.simplyappl.ai/*"],
      "js": ["detect.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*"],
      "js": ["detect-ats.js"],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.workday.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.bamboohr.com/*",
        "https://*.jobvite.com/*",
        "https://*.workable.com/*",
        "https://*.recruitee.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://simplyappl.ai/*",
        "https://www.simplyappl.ai/*"
      ]
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*"
      ],
      "js": ["discover.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.workday.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.bamboohr.com/*",
        "https://*.jobvite.com/*",
        "https://*.workable.com/*",
        "https://*.recruitee.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*"
      ],
      "js": ["mount.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
