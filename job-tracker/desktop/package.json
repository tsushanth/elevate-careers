{
    "name": "job-tracker-desktop",
    "version": "1.0.0",
    "description": "Desktop application for tracking job applications",
    "main": "src/main.js",
    "scripts": {
      "start": "electron .",
      "dev": "electron . --dev",
      "build": "electron-builder",
      "build:mac": "electron-builder --mac",
      "build:win": "electron-builder --win"
    },
    "build": {
      "appId": "com.jobtracker.app",
      "productName": "Job Tracker",
      "directories": {
        "output": "dist"
      },
      "files": [
        "src/**/*",
        "package.json"
      ],
      "mac": {
        "category": "public.app-category.productivity",
        "target": ["dmg", "zip"]
      },
      "win": {
        "target": ["nsis", "portable"]
      }
    },
    "dependencies": {
      "axios": "^1.6.2",
      "electron-store": "^8.1.0",
      "puppeteer-core": "^21.6.1"
    },
    "devDependencies": {
      "electron": "^28.0.0",
      "electron-builder": "^24.9.1"
    }
  }